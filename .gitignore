# --- Deployment output (regenerated by deploy.sh, reveals live service URLs) ---
urls.env

# --- Measurement output (regenerated by measure.py / analyze.py) ---
# Keep this ignored while you are testing. Once you have the final run for the
# paper, either force-add the specific file (git add -f results.csv) or move
# the final files into a results/ folder and exclude that from the rules below.
#*.csv
local_test*.csv
#results*.csv
#summary.csv
#latency.png
measure*.log
# Test 3: contains the live service URLs, like urls.env
services3.csv
# Test 4 (pilot and main run): same, written into Test 4/ by deploy4p.sh / deploy4.sh
services4p.csv
services4.csv

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# --- Google Cloud / credentials (should never exist in this folder, but just in case) ---
# This also keeps the Cloud Logging downloads out (Test 3/shutdown_logs.json,
# Test 4/logs4p_*.json): they contain the service URLs and, in the request log, the
# measurement VM's IP address. To publish one, force-add it (git add -f <file>) after checking it.
*.json
!package*.json
.env
*-key.json
service-account*.json

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp"*.zip" 
